{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sexytw-site",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://lsxrpubpbnshlqnnddgu.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_M_R1KxSmdgihDTFjdp_NQg_2fdMV8XW",
    "NEXT_PUBLIC_SUPABASE_SCHEMA": "public",
    "NEXT_PUBLIC_MEDIA_PREFIX": "sexytw",
    "SITE_URL": "https://sexytw.cc",
    "NEXT_PUBLIC_SITE_URL": "https://sexytw.cc"
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
